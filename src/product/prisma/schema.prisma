generator client {
  provider = "prisma-client-js"
  // use default output path so @prisma/client resolves correctly
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

model PlatformRequest {
  id        String   @id
  tenantId  String
  userId    String
  action    String
  resource  String
  status    String   @default("pending")
  payload   Json?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_requests")
  @@index([tenantId, resource])
}

model OrchestrationDefinition {
  // orchestrationId (例: "file-upload-and-mail")
  id          String   @id
  title       String?
  description String?
  // JSON 形式の orchestration 定義
  definition  Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("orchestration_definitions")
  @@index([enabled])
}

model OrchestrationVersion {
  id              String   @id @default(cuid())
  orchestrationId String
  version         Int
  definition      Json
  createdBy       String?
  createdAt       DateTime @default(now())

  @@map("orchestration_versions")
  @@index([orchestrationId])
}
